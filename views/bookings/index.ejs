<% layout("/layouts/boilerplate") %>

<div class="container py-5">

    <h2 class="mb-1">My Bookings</h2>
    <p class="text-muted mb-4">Your upcoming and past trips.</p>

    <% if(bookings.length === 0){ %>

        <div class="alert alert-info">
            You haven't made any bookings yet.
        </div>

    <% } %>

    <div class="row">

        <% bookings.forEach(booking => { %>

            <div class="col-lg-4 col-md-6 mb-4">

                <div class="card booking-item h-100 shadow-sm">

                    <img
                        src="<%= booking.listing.image.url %>"
                        class="card-img-top booking-item-image"
                        alt="<%= booking.listing.title %>"
                    >

                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">

                            <%= booking.listing.title %>

                        </h5>

                        <p class="text-muted mb-3">

                            <i class="fa-solid fa-location-dot"></i>

                            <%= booking.listing.location %>,
                            <%= booking.listing.country %>

                        </p>

                        <ul class="list-unstyled small flex-grow-1">

                            <li>
                                <strong>Check In:</strong>
                                <%= booking.checkIn.toDateString() %>
                            </li>

                            <li>
                                <strong>Check Out:</strong>
                                <%= booking.checkOut.toDateString() %>
                            </li>

                            <li>
                                <strong>Guests:</strong>
                                <%= booking.guests %>
                            </li>

                            <li>
                                <strong>Status:</strong>

                                <span class="badge bg-success">
                                    <%= booking.status %>
                                </span>

                            </li>

                            <li class="mt-2">

                                <strong>Total:</strong>

                                ₹<%= booking.totalPrice.toLocaleString("en-IN") %>

                            </li>

                        </ul>

                        
  <div class="booking-actions mt-3">

    <a href="/listings/<%= booking.listing._id %>"
       class="btn btn-dark w-100 mb-2">
        View Listing
    </a>

    <% if(new Date(booking.checkOut) >= new Date().setHours(0,0,0,0)){ %>

        <form
            action="/bookings/<%= booking._id %>?_method=DELETE"
            method="POST">

            <button
                class="btn btn-danger w-100">
                Cancel Booking
            </button>

        </form>

    <% } else { %>

        <span class="badge bg-success w-100 py-2 fs-6">
            ✓ Stay Completed
        </span>

    <% } %>

</div>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</div>
<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/aiResult.css">
<div class="container py-5">

<div class="card ai-card">

<div class="ai-header">

<h1>
    ✨ <%= itinerary.destination %>
</h1>

<p>

<%= itinerary.duration %> •
<%= itinerary.budget %>

</p>

</div>
<% if (itinerary.weatherInsight) { %>

<div class="alert alert-info shadow-sm my-4">

    <h5 class="mb-2">
        🌤 AI Weather Insight
    </h5>

    <p class="mb-0">
        <%= itinerary.weatherInsight %>
    </p>

</div>

<% } %>

<div class="ai-content">

<p class="lead mb-5">

<%= itinerary.summary %>

</p>

<h2>📅 Daily Itinerary</h2>

<% itinerary.days.forEach(day=>{ %>

<div class="card mb-4 shadow-sm">

<div class="card-body">

<h4><%= day.title %></h4>

<hr>

<p>

🌅 <strong>Morning</strong>

<br>

<%= day.morning %>

</p>

<p>

☀ <strong>Afternoon</strong>

<br>

<%= day.afternoon %>

</p>

<p>

🌙 <strong>Evening</strong>

<br>

<%= day.evening %>

</p>

</div>

</div>

<% }) %>

<h2>🎒 Packing</h2>

<ul>

<% itinerary.packing.forEach(item=>{ %>

<li><%= item %></li>

<% }) %>

</ul>

<h2>🍽 Local Foods</h2>

<ul>

<% itinerary.foods.forEach(item=>{ %>

<li><%= item %></li>

<% }) %>

</ul>

<h2>💡 Travel Tips</h2>

<ul>

<% itinerary.tips.forEach(item=>{ %>

<li><%= item %></li>

<% }) %>

</ul>

<h2>💰 Estimated Budget</h2>

<p>

<strong>

<%= itinerary.estimatedBudget %>

</strong>

</p>

<div class="ai-footer">

<a href="/trip-planner"
class="btn ai-btn ai-btn-primary">

✨ Plan Another Trip

</a>

<button
class="btn ai-btn ai-btn-secondary"
onclick="window.print()">

🖨 Print

</button>

</div>

</div>

</div>

</div>
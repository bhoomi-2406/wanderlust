<div class="card shadow-sm border-0 mt-5 ai-chat-card">

   <div class="card-header ai-header">

    <h4 class="mb-1">
        🤖 AI Travel Assistant
    </h4>

    <small>
        Ask anything about this property, weather, nearby places or travel tips.
    </small>

</div>

    <div class="card-body">

        <div id="chatMessages" class="chat-messages">

            <div class="ai-message">

                <div class="bubble ai-bubble">

                    👋 Hi! I'm your AI Travel Assistant.

                    Ask me anything about this destination,
                    nearby places, weather,
                    budget or travel tips.

                </div>

            </div>

        </div>

        <div class="input-group mt-3">

            <input
                id="aiQuestion"
                type="text"
                class="form-control"
                placeholder="Ask anything...">

            <button
                id="askAIBtn"
                class="btn btn-dark">

                Send

            </button>

        </div>

    </div>

</div>
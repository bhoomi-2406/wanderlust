    <p class="text-muted mb-4">
        Discover popular places within <strong>3 km</strong> of this stay.
    </p>

    <% const categories = [
        {
            title: "🍽 Restaurants",
            places: groupedPlaces.restaurants
        },
        {
            title: "☕ Cafés",
            places: groupedPlaces.cafes
        },
        {
            title: "🏛 Attractions",
            places: groupedPlaces.attractions
        },
        {
            title: "🏥 Hospitals",
            places: groupedPlaces.hospitals
        },
        {
            title: "🏧 ATMs",
            places: groupedPlaces.atms
        }
    ]; %>

<div class="accordion" id="nearbyAccordion">

<% categories.forEach((category,index)=>{ %>

<% if(category.places.length){ %>

<div class="accordion-item mb-3">

<h2 class="accordion-header">

<button
class="accordion-button <%= index!==0 ? 'collapsed' : '' %>"
type="button"
data-bs-toggle="collapse"
data-bs-target="#nearby<%= index %>">

<%= category.title %>

<span class="badge bg-dark ms-3">

<%= category.places.length %>

</span>

</button>

</h2>

<div
id="nearby<%= index %>"
class="accordion-collapse collapse <%= index===0 ? 'show' : '' %>"
data-bs-parent="#nearbyAccordion">

<div class="accordion-body">

<% category.places.slice(0,5).forEach(place=>{ %>

<div class="place-card">

<div class="place-info">

<h6>

<%= place.properties.name || "Unnamed Place" %>

</h6>

<p>

<%= place.properties.address_line2 || "" %>

</p>

</div>

<div class="place-right">

<div class="distance">

🧭 <%= place.properties.distance %> m

</div>

</div>

</div>

<% }) %>

</div>

</div>

</div>

<% } %>

<% }) %>

</div>

</div>

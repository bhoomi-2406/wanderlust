<% layout("/layouts/boilerplate") %>

<div class="container py-4">

    <div class="listing-header mb-4">
        <h2 class="fw-bold mb-2"><%= listing.title %></h2>

        <div class="d-flex align-items-center gap-3 text-muted flex-wrap">
            <span>
                <i class="fa-solid fa-location-dot"></i>
                <%= listing.location %>, <%= listing.country %>
            </span>

            <span class="badge bg-dark">
                <%= listing.category %>
            </span>

            <span>
                Hosted by <strong><%= listing.owner.username %></strong>
            </span>
        </div>
    </div>

    <div class="row g-5">

        <div class="col-lg-8">

            <div class="property-image-wrapper">

                <img
                    src="<%= listing.image.url %>"
                    alt="<%= listing.title %>"
                    class="property-image"
                >

                <% if(currUser){ %>

                    <% if(isWishlisted){ %>

                        <form action="/listings/<%= listing._id %>/wishlist?_method=DELETE" method="POST">

                            <button class="wishlist-btn saved">

                                <i class="fa-solid fa-heart"></i>

                            </button>

                        </form>

                    <% } else { %>

                        <form action="/listings/<%= listing._id %>/wishlist" method="POST">

                            <button class="wishlist-btn">

                                <i class="fa-regular fa-heart"></i>

                            </button>

                        </form>

                    <% } %>

                <% } %>

            </div>

            <div class="property-summary mt-4">

                <div class="summary-card">

                    <i class="fa-solid fa-user-group"></i>

                    <span><%= listing.maxGuests %> Guests</span>

                </div>

                <div class="summary-card">

                    <i class="fa-solid fa-bed"></i>

                    <span><%= listing.bedrooms %> Bedrooms</span>

                </div>

                <div class="summary-card">

                    <i class="fa-solid fa-bath"></i>

                    <span><%= listing.bathrooms %> Bathrooms</span>

                </div>

            </div>

            <div class="description-section mt-5">

                <h4>Description</h4>

                <p class="text-muted">

                    <%= listing.description %>

                </p>

            </div>
            <!-- Amenities Section -->
<div class="amenities-section mt-5">

    <h4 class="mb-4">
        <i class="fa-solid fa-house-circle-check me-2"></i>
        What this place offers
    </h4>

    <% if (listing.amenities && listing.amenities.length > 0) { %>

        <div class="row g-3">

            <% listing.amenities.forEach((amenity) => { %>

                <div class="col-md-6">

                    <div class="border rounded p-3 h-100 d-flex align-items-center">

                        <% if (amenity === "WiFi") { %>
                            <i class="fa-solid fa-wifi me-3"></i>

                        <% } else if (amenity === "Kitchen") { %>
                            <i class="fa-solid fa-kitchen-set me-3"></i>

                        <% } else if (amenity === "Parking") { %>
                            <i class="fa-solid fa-square-parking me-3"></i>

                        <% } else if (amenity === "Pool") { %>
                            <i class="fa-solid fa-person-swimming me-3"></i>

                        <% } else if (amenity === "Air Conditioning") { %>
                            <i class="fa-regular fa-snowflake me-3"></i>

                        <% } else if (amenity === "Breakfast") { %>
                            <i class="fa-solid fa-mug-hot me-3"></i>

                        <% } else if (amenity === "Fireplace") { %>
                            <i class="fa-solid fa-fire me-3"></i>

                        <% } else if (amenity === "Pet Friendly") { %>
                            <i class="fa-solid fa-paw me-3"></i>

                        <% } else { %>
                            <i class="fa-solid fa-check me-3"></i>
                        <% } %>

                        <span><%= amenity %></span>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } else { %>

        <p class="text-muted">
            No amenities listed for this property.
        </p>

    <% } %>

</div>

        </div>

        <div class="col-lg-4">

            <div class="show-booking-card">

    <div class="price-section">
        <span id="nightPrice">
    ₹<%= listing.price.toLocaleString("en-IN") %>
</span>
       <span id="nightText">1 night</span>
    </div>

    <%
let avgRating = 0;

if (listing.reviews.length > 0) {
    avgRating =
        listing.reviews.reduce((sum, review) => sum + review.rating, 0)
        / listing.reviews.length;
}
%>

<p class="rating-text">

    <% if(listing.reviews.length > 0){ %>

        ⭐ <%= avgRating.toFixed(1) %>
        (<%= listing.reviews.length %>
        <%= listing.reviews.length === 1 ? "review" : "reviews" %>)

    <% } else { %>

        ⭐ New · No reviews yet

    <% } %>

</p>

    <hr>

    <form
    action="/bookings/<%= listing._id %>"
    method="POST"
>

        <div class="booking-inputs">

            <div>
                <label>Check In</label>
                <input
    type="date"
    class="form-control"
    id="checkIn"
     name="checkIn"
    min="<%= new Date().toISOString().split('T')[0] %>"
>
            </div>

            <div>
                <label>Check Out</label>
               <input
    type="date"
    class="form-control"
    id="checkOut"
    name="checkOut"
    min="<%= new Date().toISOString().split('T')[0] %>"
>
            </div>

        </div>

        <div class="mt-3">
            <label>Guests</label>

            <select
    class="form-select"
    name="guests"
>

                <% for(let i=1;i<=listing.maxGuests;i++){ %>

                    <option><%= i %></option>

                <% } %>

            </select>

        </div>

        <button class="btn btn-danger w-100 mt-4">

            Reserve

        </button>
        <a
    href="/trip-planner/<%= listing._id %>"
    class="btn btn-outline-primary w-100 mt-3">

    ✨ Plan My Trip

</a>

    </form>
    <hr class="my-4">

<h5 class="mb-3">
    Unavailable Dates
</h5>

<% if(bookedDates.length === 0){ %>

    <p class="text-success">
        No bookings yet. This property is fully available.
    </p>

<% } else { %>

    <ul class="list-group">

        <% bookedDates.forEach(date => { %>

            <li class="list-group-item">

                <strong>

                    <%= date.checkIn.toLocaleDateString("en-IN", {
                        day: "numeric",
                        month: "short",
                        year: "numeric"
                    }) %>

                </strong>

                →

                <strong>

                    <%= date.checkOut.toLocaleDateString("en-IN", {
                        day: "numeric",
                        month: "short",
                        year: "numeric"
                    }) %>

                </strong>

            </li>

        <% }) %>

    </ul>

<% } %>

    <p class="charge-text">

        You won't be charged yet.

    </p>

    <hr>

   <div class="price-breakdown">

    <div class="d-flex justify-content-between mb-2">
        <span>
            ₹<%= listing.price.toLocaleString("en-IN") %> ×
            <span id="nightCount">0</span> nights
        </span>

        <span id="subtotal">₹0</span>
    </div>

    <div class="d-flex justify-content-between mb-2">
        <span>Cleaning Fee</span>
        <span id="cleaningFee">₹800</span>
    </div>

    <div class="d-flex justify-content-between mb-2">
        <span>Service Fee</span>
        <span id="serviceFee">₹500</span>
    </div>

    <div class="d-flex justify-content-between mb-2">
        <span>Taxes (8%)</span>
        <span id="taxAmount">₹0</span>
    </div>

    <hr>

    <div class="d-flex justify-content-between fw-bold fs-5">
        <span>Total</span>
        <span id="totalPrice">₹0</span>
    </div>

</div>

</div>

        </div>

    </div>

</div>
<% if (currUser && listing.owner._id.equals(currUser._id)) { %>

<div class="container mb-5">

    <div class="d-flex gap-3">

        <a
            href="/listings/<%= listing._id %>/edit"
            class="btn btn-dark"
        >
            Edit Listing
        </a>

        <form
            action="/listings/<%= listing._id %>?_method=DELETE"

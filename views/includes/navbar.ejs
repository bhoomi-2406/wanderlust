<style>
    .search-btn{
        background-color: red;
        color: white;
        border-radius: 25px;
        padding: 0 1rem 0 1rem;
    }
     .search-btn:hover{
        background-color: red;
        color: white;
    }
    .search-btn i {
        margin-right: 1rem;
        display: inline;
    }
    .search-inp{
        border-radius: 25px;
        padding: 0.5rem 3rem 0.5rem 3 rem;
    }
    .price-filter{
width: 180px;
    }

</style>




<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="/">
    <i class="fa-solid fa-house"></i>
    <span class="brand-text ms-2">Wanderlust</span>
</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <div class="navbar-nav">
                
                <a class="nav-link" href="/listings">Explore</a>
            </div>
            <div class="navbar-nav ms-auto">

    <form class="d-flex align-items-center flex-wrap search-form" role="search" action="/listings" method="GET">

        <input
            class="form-control me-2 search-inp"
            type="search"
            placeholder="Search destinations"
            aria-label="Search"
            name="q"
            value="<%= searchQuery %>"
        />

        <select class="form-select me-2 price-filter" name="price">
            <option value="">All Prices</option>
            <option value="0-2000">Under ₹2,000</option>
            <option value="2000-5000">₹2,000 - ₹5,000</option>
            <option value="5000-10000">₹5,000 - ₹10,000</option>
            <option value="10000+">Above ₹10,000</option>
        </select>

        <button class="btn search-btn me-2" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
            Search
        </button>

        <a href="/trip-planner" class="btn ai-trip-btn">
            <i class="fa-solid fa-robot"></i>
            Plan My Trip
        </a>

    </form>

</div>

            <div class="navbar-nav ms-auto ">
                 <a class="nav-link" href="/listings/new">Airbnb your home</a>
                <% if(!currUser) { %>
                    <a class="nav-link" href="/signup"><b>Sign Up</b></a>
                    <a class="nav-link" href="/login"><b>Log In</b></a>
                    <% } %>
                        <% if(currUser) { %>
                            <a class="nav-link" href="/wishlist">
        <i class="fa-solid fa-heart"></i> Wishlist
    </a>
     <a class="nav-link" href="/bookings">
        <i class="fa-solid fa-calendar-check"></i>
        My Bookings
    </a>
    <a class="nav-link" href="/dashboard">
    <i class="fa-solid fa-chart-line"></i>
    Dashboard
</a>
                            <a class="nav-link" href="/logout"><b>Log Out</b></a>
                            <% } %>

            </div>
        </div>
    </div>
</nav>